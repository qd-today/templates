[
    {
        "comment": "获取毫秒时间戳(gatewayTimestamp)",
        "request": {
            "method": "GET",
            "url": "api://util/timestamp",
            "headers": [],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "ts_us",
                    "re": "\"16位时间戳\":\\s*(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "每日签到",
        "request": {
            "method": "GET",
            "url": "https://tspapph5.yadeaiot.com.cn/prod-wg/api/app/userappruleinfo/addsigninbyuseridNew",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh-Hans;q=0.9"
                },
                {
                    "name": "Authorization",
                    "value": "Bearer {{token}}"
                },
                {
                    "name": "Content-Type",
                    "value": "x-www-form-urlencoded;charset=utf-8"
                },
                {
                    "name": "Origin",
                    "value": "https://tspapph5.yadeaiot.com.cn"
                },
                {
                    "name": "Referer",
                    "value": "https://tspapph5.yadeaiot.com.cn/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 18_7 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 YadeaApp/8.8.10"
                },
                {
                    "name": "gatewayAppId",
                    "value": "cfb00038ddac4c9ebc85821694bbd3fa"
                },
                {
                    "name": "gatewayTimestamp",
                    "value": "{{ ts_us[:13] }}"
                },
                {
                    "name": "gatewaySign",
                    "value": "{{ aes_encrypt('gatewayTimestamp=' ~ ts_us[:13] ~ '&json={}', 'RFC1J02e116b45a0', 'ECB', '') }}"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "sign_enc",
                    "re": "(.*)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "解密签到响应并校验业务码",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content={{ urlencode(aes_decrypt(regex_replace(regex_replace(regex_replace(sign_enc, '%2B', '+'), '%2F', '/'), '%3D', '='), 'RFC1J02e116b45a0', 'ECB', '')) }}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "000000|120168",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "sign_msg",
                    "re": "msg\\\\\":\\s*\\\\\"([^\\\\\"]+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "查询积分概况",
        "request": {
            "method": "GET",
            "url": "https://tspapph5.yadeaiot.com.cn/prod-wg/api/app/userappruleinfo/queryuserappruleinfobyuserid",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh-Hans;q=0.9"
                },
                {
                    "name": "Authorization",
                    "value": "Bearer {{token}}"
                },
                {
                    "name": "Content-Type",
                    "value": "x-www-form-urlencoded;charset=utf-8"
                },
                {
                    "name": "Origin",
                    "value": "https://tspapph5.yadeaiot.com.cn"
                },
                {
                    "name": "Referer",
                    "value": "https://tspapph5.yadeaiot.com.cn/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 18_7 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 YadeaApp/8.8.10"
                },
                {
                    "name": "gatewayAppId",
                    "value": "cfb00038ddac4c9ebc85821694bbd3fa"
                },
                {
                    "name": "gatewayTimestamp",
                    "value": "{{ ts_us[:13] }}"
                },
                {
                    "name": "gatewaySign",
                    "value": "{{ aes_encrypt('gatewayTimestamp=' ~ ts_us[:13] ~ '&json={}', 'RFC1J02e116b45a0', 'ECB', '') }}"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "info_enc",
                    "re": "(.*)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "解密积分响应并提取数据",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content={{ urlencode(aes_decrypt(regex_replace(regex_replace(regex_replace(info_enc, '%2B', '+'), '%2F', '/'), '%3D', '='), 'RFC1J02e116b45a0', 'ECB', '')) }}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "integral",
                    "re": "integral\\\\\":\\s*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "signinDay",
                    "re": "signinDay\\\\\":\\s*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "isSignin",
                    "re": "isSignin\\\\\":\\s*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "nickName",
                    "re": "nickName\\\\\":\\s*\\\\\"([^\\\\\"]+)",
                    "from": "content"
                },
                {
                    "name": "userId",
                    "re": "userId\\\\\":\\s*(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "生成任务日志",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content={{ urlencode('雅迪智行：' ~ sign_msg ~ '｜用户：' ~ nickName ~ '（ID: ' ~ userId ~ '）｜总积分 ' ~ integral ~ ' 分｜连续签到 ' ~ signinDay ~ ' 天｜' ~ ternary(isSignin == '0', '今日已签到', '今日未签到')) }}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\":\\s*\"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]