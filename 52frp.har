[
    {
        "comment": "登录",
        "request": {
            "method": "POST",
            "url": "https://www.52frp.com/api/user/login",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.52frp.com"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Google Chrome\";v=\"132\""
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "Origin",
                    "value": "https://www.52frp.com"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Referer",
                    "value": "https://www.52frp.com/user/"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                }
            ],
            "cookies": [],
            "data": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "token",
                    "re": "\"token\":\"(.*?)\"",
                    "from": "content"
                },
                {
                    "name": "csrf_token",
                    "re": "\"csrf_token\":\"(.*?)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "获取token",
        "request": {
            "method": "GET",
            "url": "https://www.52frp.com/api/user/slider-token",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.52frp.com"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "Authorization",
                    "value": "Bearer {{token}}"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Google Chrome\";v=\"132\""
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Referer",
                    "value": "https://www.52frp.com/user/"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "slider_token",
                    "re": "\"token\":\"(.*?)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "签到",
        "request": {
            "method": "POST",
            "url": "https://www.52frp.com/api/user/sign",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.52frp.com"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "Authorization",
                    "value": "Bearer {{token}}"
                },
                {
                    "name": "X-CSRF-Token",
                    "value": "{{csrf_token}}"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Google Chrome\";v=\"132\""
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "Origin",
                    "value": "https://www.52frp.com"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Referer",
                    "value": "https://www.52frp.com/user/"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                }
            ],
            "cookies": [],
            "data": "{\"slider_token\":\"{{slider_token}}\"}",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "今日签到尝试次数已达上限，请明天再试",
                    "from": "content"
                }
            ],
            "extract_variables": []
        }
    },
    {
        "comment": "信息",
        "request": {
            "method": "GET",
            "url": "https://www.52frp.com/api/user/sign/info",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.52frp.com"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "Authorization",
                    "value": "Bearer {{token}}"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Google Chrome\";v=\"132\""
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Referer",
                    "value": "https://www.52frp.com/user/"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "ljqd",
                    "re": "\"total_sign_days\":(\\d+)",
                    "from": "content"
                },
                {
                    "name": "qdhd",
                    "re": "\"last_traffic\":(\\d+)",
                    "from": "content"
                },
                {
                    "name": "kyll",
                    "re": "sign_available_traffic\":(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "Unicode转换",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=累计签到{{ljqd}}天，签到获得{{ format(float(divide(int(qdhd), 1048576)), \"0.2f\") }} MB，可用流量{{ format(float(divide(int(kyll), 1048576)), \"0.2f\") }} MB。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]