[
    {
        "comment": "Unicode转换",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content={{dg}}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "dg",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                },
                {
                    "name": "login_chunk",
                    "re": "",
                    "from": "content"
                },
                {
                    "name": "home_chunk",
                    "re": "",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "FlareSolverr过盾",
        "request": {
            "method": "POST",
            "url": "{{flaresolverr_url}}",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/json"
                }
            ],
            "cookies": [],
            "data": "{\n    \"cmd\": \"request.get\",\n    \"url\": \"https://{{domain}}/login\",\n    \"maxTimeout\": 120000{% if flaresolverr_proxy_url %},\n    \"proxy\": {\"url\": \"{{flaresolverr_proxy_url}}\"}{% endif %}\n}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "\"status\": \"error\"",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "ua",
                    "re": "\"userAgent\": \"(.+?)\"",
                    "from": "content"
                },
                {
                    "name": "cf_clearance",
                    "re": "\"name\": \"cf_clearance\".+?\"value\": \"(.+?)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "获取登录页",
        "request": {
            "method": "GET",
            "url": "https://{{domain}}/login",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "cf_clearance={{cf_clearance}}"
                },
                {
                    "name": "Origin",
                    "value": "https://{{domain}}"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/login"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "Just a moment",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "login_chunks",
                    "re": "/(static\\/chunks\\/[^\"'\\\\\\s<>]+?\\.js)/g",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "For 循环开始",
        "request": {
            "method": "GET",
            "url": "{% for login_chunk in list(dict.fromkeys(login_chunks)) %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "扫描chunk-login",
        "request": {
            "method": "GET",
            "url": "https://{{domain}}/_next/{{login_chunk}}",
            "headers": [
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/login"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "next_action_login",
                    "re": "createServerReference(?:\\)|\\s*)\\s*\\(\\s*[\"']([^\"']+)[\"'][^;]{0,500}?,\\s*[\"']login[\"']\\s*\\)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "For 循环结束",
        "request": {
            "method": "GET",
            "url": "{% endfor %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "登录",
        "request": {
            "method": "POST",
            "url": "https://{{domain}}/login",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "text/plain;charset=UTF-8"
                },
                {
                    "name": "Origin",
                    "value": "https://{{domain}}"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/login"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                },
                {
                    "name": "Next-Action",
                    "value": "{{next_action_login}}"
                },
                {
                    "name": "Accept",
                    "value": "text/x-component"
                }
            ],
            "cookies": [],
            "data": "[{\"username\":\"{{username}}\",\"password\":\"{{password}}\"},\"/\"]"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "用户名或密码错误",
                    "from": "content"
                },
                {
                    "re": "请求参数错误",
                    "from": "content"
                }
            ],
            "extract_variables": []
        }
    },
    {
        "comment": "获取首页",
        "request": {
            "method": "GET",
            "url": "https://{{domain}}/",
            "headers": [
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "Just a moment",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "home_chunks",
                    "re": "/(static\\/chunks\\/[^\"'\\\\\\s<>]+?\\.js)/g",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "For 循环开始",
        "request": {
            "method": "GET",
            "url": "{% for home_chunk in list(dict.fromkeys(home_chunks)) %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "扫描chunk-checkIn",
        "request": {
            "method": "GET",
            "url": "https://{{domain}}/_next/{{home_chunk}}",
            "headers": [
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "next_action_checkin",
                    "re": "createServerReference(?:\\)|\\s*)\\s*\\(\\s*[\"']([^\"']+)[\"'][^;]{0,500}?,\\s*[\"']checkIn[\"']\\s*\\)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "For 循环结束",
        "request": {
            "method": "GET",
            "url": "{% endfor %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "判断条件成立",
        "request": {
            "method": "GET",
            "url": "{% if dg == \"yes\" %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "赌狗签到",
        "request": {
            "method": "POST",
            "url": "https://{{domain}}/",
            "headers": [
                {
                    "name": "Origin",
                    "value": "https://{{domain}}"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                },
                {
                    "name": "Content-Type",
                    "value": "text/plain;charset=UTF-8"
                },
                {
                    "name": "Next-Action",
                    "value": "{{next_action_checkin}}"
                }
            ],
            "cookies": [],
            "data": "[true,\"$undefined\"]"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"success\":true",
                    "from": "content"
                },
                {
                    "re": "你已经签到过了，明天再来吧",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "action_proof_challenge_failed",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "msg",
                    "re": "\"message\":\"([^\"]+)\"",
                    "from": "content"
                },
                {
                    "name": "description",
                    "re": "\"message\":\"[^\"]*\",\"description\":\"([^\"]+)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断条件不成立",
        "request": {
            "method": "GET",
            "url": "{% else %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "普通签到",
        "request": {
            "method": "POST",
            "url": "https://{{domain}}/",
            "headers": [
                {
                    "name": "Origin",
                    "value": "https://{{domain}}"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                },
                {
                    "name": "Content-Type",
                    "value": "text/plain;charset=UTF-8"
                },
                {
                    "name": "Next-Action",
                    "value": "{{next_action_checkin}}"
                }
            ],
            "cookies": [],
            "data": "[false,\"$undefined\"]"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"success\":true",
                    "from": "content"
                },
                {
                    "re": "你已经签到过了，明天再来吧",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "action_proof_challenge_failed",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "msg",
                    "re": "\"message\":\"([^\"]+)\"",
                    "from": "content"
                },
                {
                    "name": "description",
                    "re": "\"message\":\"[^\"]*\",\"description\":\"([^\"]+)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断块结束",
        "request": {
            "method": "GET",
            "url": "{% endif %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "request": {
            "method": "GET",
            "url": "https://{{domain}}/manager/account",
            "headers": [
                {
                    "name": "Referer",
                    "value": "https://{{domain}}/"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua}}"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "nickname",
                    "re": "\\\\\"nickname\\\\\":\\\\\\\"([^\\\\\"]+?)\\\\\\\",\\\\\\\"username\\\\\":\\\\\\\"",
                    "from": "content"
                },
                {
                    "name": "points",
                    "re": "\\\\\"points\\\\\":(\\d+),",
                    "from": "content"
                },
                {
                    "name": "days",
                    "re": "\\\\\"signin_days_total\\\\\":(\\d+),",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "Unicode转换",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户名：{{nickname}}\\r\\n 积分：{{points}}，总签到天数：{{days}}\\r\\n 签到结果：{{msg}}，{{description}}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]