[
    {
        "comment": "登录网站，获取nonce，基础信息",
        "request": {
            "method": "GET",
            "url": "https:///{{domian}}/user",
            "headers": [
                {
                    "name": "referer",
                    "value": "https://{{domian}}/"
                },
                {
                    "name": "user-agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,zh-HK;q=0.7,en-US;q=0.6,en;q=0.5"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "document"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "navigate"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-User",
                    "value": "?1"
                },
                {
                    "name": "Priority",
                    "value": "u=0, i"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "nonce",
                    "re": "data-nonce=\"(.*?)\"",
                    "from": "content"
                },
                {
                    "name": "nickname",
                    "re": "<.+class=\"mx-display-name\">(.*?)<span",
                    "from": "content"
                },
                {
                    "name": "level",
                    "re": "<span.+?xy-lv xy-lv-2.+>.+</span>",
                    "from": "content"
                },
                {
                    "name": "next_level",
                    "re": "<.+xy-level-bar-2.+\\n?.+xy-udrop-tile-sub.+\\n",
                    "from": "content"
                },
                {
                    "name": "exp",
                    "re": "LV2.+?(\\d+)[ ]+点",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "签到，获得签到信息",
        "request": {
            "method": "POST",
            "url": "https://{{domian}}/wp-admin/admin-ajax.php",
            "headers": [
                {
                    "name": "origin",
                    "value": "https://{{domian}}"
                },
                {
                    "name": "referer",
                    "value": "https://{{domian}}/user"
                },
                {
                    "name": "user-agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,zh-HK;q=0.7,en-US;q=0.6,en;q=0.5"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "document"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "navigate"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-User",
                    "value": "?1"
                },
                {
                    "name": "Priority",
                    "value": "u=0, i"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": [],
            "data": "action=user_qiandao&nonce={{nonce}}",
            "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "\\u7b7e\\u5230\\u6210\\u529f",
                    "from": "content"
                },
                {
                    "re": "400",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "\\\\u975e\\\\u6cd5\\\\u8bf7\\\\u6c42\\\\uff0c\\\\u8bf7\\\\u5237\\\\u65b0\\\\u91cd\\\\u8bd5",
                    "from": "content"
                },
                {
                    "re": "\\\\u8bf7\\\\u767b\\\\u5f55\\\\u540e\\\\u7b7e\\\\u5230",
                    "from": "content"
                },
                {
                    "re": "status[:\" ]{2,10}0",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "msg",
                    "re": "\"msg\":\"(.*?)\"",
                    "from": "content"
                },
                {
                    "name": "reward",
                    "re": "reward[:\" ]{2,10}([\\d\\.]{1,10})",
                    "from": "content"
                },
                {
                    "name": "qd_coin",
                    "re": "qd_coin[:\" ]{2,10}([\\d\\.]{1,10})",
                    "from": "content"
                },
                {
                    "name": "coin",
                    "re": "[\" ]{1,6}coin[:\" ]{2,10}([\\d\\.]{1,10})",
                    "from": "content"
                },
                {
                    "name": "streak",
                    "re": "streak[:\" ]{2,10}([\\d\\.]{1,10})",
                    "from": "content"
                },
                {
                    "name": "days",
                    "re": "days[:\" ]{2,10}([\\d\\.]{1,10})",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断签到是否成功",
        "request": {
            "method": "GET",
            "url": "{% if reward %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换，签到成功",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{nickname}}，本次签到成功，获得{{reward}}签到币，已连续{{streak}}天签到。\\r\\n\n目前等级{{level | striptags}}，经验{{exp}}点，{{next_level | striptags}}。现有赞助币{{coin}}，签到币{{qd_coin}}。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "签到不成功",
        "request": {
            "method": "GET",
            "url": "{% else %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "获取账户信息",
        "request": {
            "method": "GET",
            "url": "https://{{domian}}/user",
            "headers": [
                {
                    "name": "referer",
                    "value": "https://{{domian}}/"
                },
                {
                    "name": "user-agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "cookie",
                    "value": "{{cookie}}"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,zh-HK;q=0.7,en-US;q=0.6,en;q=0.5"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "document"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "navigate"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-User",
                    "value": "?1"
                },
                {
                    "name": "Priority",
                    "value": "u=0, i"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "nickname",
                    "re": "<.+class=\"mx-display-name\">(.*?)<span",
                    "from": "content"
                },
                {
                    "name": "qd_coin",
                    "re": "<.+?xy-utop-stat-num.+?([\\d\\.]+)",
                    "from": "content"
                },
                {
                    "name": "coin",
                    "re": "<.+?xy-utop-stat-num.+\\n.+?([\\d\\.]+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "Unicode转换，签到不成功的日志",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{nickname}}，本次签到未成功，原因“{{msg}}”。\\r\\n\n目前等级{{level | striptags}}，{{exp | striptags}}点经验，{{next_level | striptags}}。现有赞助币{{coin}}，签到币{{qd_coin}}。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断块结束",
        "request": {
            "method": "GET",
            "url": "{% endif %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    }
]