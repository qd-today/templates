[
    {
        "comment": "获取当前 13 位 Unix 毫秒时间戳，用于签到 URL。",
        "request": {
            "method": "POST",
            "url": "api://util/timestamp",
            "headers": [],
            "cookies": [],
            "data": "ts=&form=&dt=",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "timestamp",
                    "re": "\"16位时间戳\":\\s*(\\d{13})",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "4399 签到（实测响应为 JSON：code=101 表示已签到，未登录返回 code=99 Not logined；签到成功提取 result 文案到日志）。",
        "request": {
            "method": "GET",
            "url": "https://my.4399.com/plugins/sign/set-t-{{timestamp}}",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/javascript, */*; q=0.01"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6,zh-Hans;q=0.5"
                },
                {
                    "name": "Referer",
                    "value": "https://my.4399.com/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36 Edg/153.0.0.0"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Microsoft Edge\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"code\":\\s*\\d+",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "Not logined|请先登录|登录后签到",
                    "from": "content"
                },
                {
                    "re": "401|403",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "sign_msg",
                    "re": "\"result\":\"([^\"]*)\"",
                    "from": "content"
                },
                {
                    "name": "sign_code",
                    "re": "\"code\":\\s*(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "读取签到后的 uid、credit、username。响应为 JSONP，字段从 setUserInfo(...) 中提取。",
        "request": {
            "method": "GET",
            "url": "https://my.4399.com/home/index-getUserCreditInfo?callback=setUserInfo",
            "headers": [
                {
                    "name": "Accept",
                    "value": "text/javascript, application/javascript, application/ecmascript, application/x-ecmascript, */*; q=0.01"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6,zh-Hans;q=0.5"
                },
                {
                    "name": "Referer",
                    "value": "https://my.4399.com/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36 Edg/153.0.0.0"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "setUserInfo\\(\\{",
                    "from": "content"
                },
                {
                    "re": "\"uid\":\"[^\"]+\"",
                    "from": "content"
                },
                {
                    "re": "\"username\":\"[^\"]*\"",
                    "from": "content"
                },
                {
                    "re": "\"credit\":\"[^\"]*\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "请先登录|登录后",
                    "from": "content"
                },
                {
                    "re": "401|403",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "uid",
                    "re": "\"uid\":\"([^\"]+)\"",
                    "from": "content"
                },
                {
                    "name": "credit",
                    "re": "\"credit\":\"([^\"]*)\"",
                    "from": "content"
                },
                {
                    "name": "username",
                    "re": "\"username\":\"([^\"]*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "解码签到结果文案（响应 result 为 \\uXXXX 转义）。",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content={{sign_msg}}",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "sign_res",
                    "re": "\"转换后\": \"([^\"]*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "生成签到日志，显示签到结果、uid、积分、账号。",
        "request": {
            "method": "POST",
            "url": "api://util/urldecode",
            "headers": [],
            "cookies": [],
            "data": "content=%E7%AD%BE%E5%88%B0%E7%BB%93%E6%9E%9C%3A%20{{sign_res}}%20%7C%20uid%3A%20{{uid}}%20%7C%20%E7%A7%AF%E5%88%86%3A%20{{credit}}%20%7C%20%E8%B4%A6%E5%8F%B7%3A%20{{username}}",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]