                    "re": "streak[\": ]{2,6}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "m_bonus",
                    "re": "member_bonus[\": ]{2,6}([\\d-]+)",
                    "from": "content"
                },
                {
                    "name": "sign_day",
                    "re": "day[\": ]{2,6}([\\d-]+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "Unicode转换；输出已签到日志",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{nickname}}，等级{{level}}。本次签到未成功，因为\"{{msg}}\"。用户现有{{total_points}}钻石，离下一等级还差{{p2next}}钻石。\\r\\n最近一次签到：{{sign_day}}日的第{{day_order}}位签到者，已连续签到{{streak}}天，当时获得{{get_points}}钻石。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断块结束",
        "request": {
            "method": "GET",
            "url": "{% endif %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    }
]