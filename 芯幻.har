[
    {
        "comment": "登录网站",
        "request": {
            "method": "POST",
            "url": "https:///{{domian}}/api/session/login",
            "headers": [
                {
                    "name": "Host",
                    "value": "{{domian}}"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domian}}/login?redirect=%2F"
                },
                {
                    "name": "content-type",
                    "value": "application/json"
                },
                {
                    "name": "Origin",
                    "value": "https://{{domian}}"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Priority",
                    "value": "u=0"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": [],
            "data": "{\"account\":\"{{account}}\",\"password\":\"{{password}}\"}",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "message[\": ]{2,6}success",
                    "from": "content"
                },
                {
                    "re": "code[\": ]{2,6}0",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "message[\": ]{2,6}invalid",
                    "from": "content"
                },
                {
                    "re": "data[\": ]{2,6}null",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "nickname",
                    "re": "nickname[\": ]{2,6}(.+?)[\", ]{2,6}",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "签到",
        "request": {
            "method": "POST",
            "url": "https:///{{domian}}/api/v1/users/me/signin",
            "headers": [
                {
                    "name": "Host",
                    "value": "{{domian}}"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domian}}/login?redirect=%2F"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Priority",
                    "value": "u=4"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "signed[\": ]{2,6}false",
                    "from": "content"
                },
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "message[\": ]{2,6}unauthorized",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "get_points",
                    "re": "points[\": ]{2,6}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "day_order",
                    "re": "day_order[\": ]{2,6}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "bonus",
                    "re": "[\" ]bonus[\": ]{2,6}([\\d-]+)",
                    "from": "content"
                },
                {
                    "name": "streak",
                    "re": "streak[\": ]{2,6}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "msg",
                    "re": "message[\": ]{2,6}(.+?)[, \"]{2,8}",
                    "from": "content"
                },
                {
                    "name": "m_bonus",
                    "re": "member_bonus[\": ]{2,6}([\\d-]+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "获取信息",
        "request": {
            "method": "GET",
            "url": "https://{{domian}}/api/v1/users/me",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domian}}/login?redirect=%2F"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Priority",
                    "value": "u=4"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "code[\": ]{2,6}0",
                    "from": "content"
                },
                {
                    "re": "message[\": ]{3,6}success",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "data[\": ]{1,6}null",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "nickname",
                    "re": "nickname[\\\": ]{2,6}(\\w+)",
                    "from": "content"
                },
                {
                    "name": "level",
                    "re": "level_name[\\\": ]{2,6}([\\w\\.]+)",
                    "from": "content"
                },
                {
                    "name": "total_points",
                    "re": "points[\\\": ]{2,6}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "p2next",
                    "re": "points_to_next_level[\\\": ]{2,6}(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断签到是否成功",
        "request": {
            "method": "GET",
            "url": "{% if msg==\"success\" %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换；输出签到成功日志",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{nickname}}，等级{{level}}。今日第{{day_order}}位签到者，已连续签到{{streak}}天，本次获得{{get_points}}钻石，奖励{{bonus}}，会员奖励{{m_bonus}}。签到完总共有{{total_points}}钻石，离下一等级还差{{p2next}}钻石。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断条件不成立",
        "request": {
            "method": "GET",
            "url": "{% else %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "查询签到信息",
        "request": {
            "method": "GET",
            "url": "https:///{{domian}}/api/v1/users/me/signin",
            "headers": [
                {
                    "name": "Host",
                    "value": "{{domian}}"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domian}}/login?redirect=%2F"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
