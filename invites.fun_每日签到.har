[
    {
        "comment": "刷新session/校验登录/获取CSRF与UID｜变量: remember=flarum_remember(必填), ua=浏览器User-Agent(选填，留空自动用通用UA)",
        "request": {
            "method": "GET",
            "url": "https://invites.fun/",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "flarum_remember={{remember}}"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua|default('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36')}}"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "identity"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"userId\":[0-9]+",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "csrf",
                    "re": "\"csrfToken\":\"(.+?)\"}",
                    "from": "content"
                },
                {
                    "name": "uid",
                    "re": "\"userId\":(\\d+),",
                    "from": "content"
                },
                {
                    "name": "session",
                    "re": "flarum_session=([^;]+)",
                    "from": "header-set-cookie"
                }
            ]
        }
    },
    {
        "comment": "提交签到（POST /api/checkin）",
        "request": {
            "method": "POST",
            "url": "https://invites.fun/api/checkin",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/javascript, */*; q=0.01"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "identity"
                },
                {
                    "name": "Cookie",
                    "value": "flarum_remember={{remember}}{% if session %}; flarum_session={{session}}{% endif %}"
                },
                {
                    "name": "Origin",
                    "value": "https://invites.fun"
                },
                {
                    "name": "Referer",
                    "value": "https://invites.fun/"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua|default('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36')}}"
                },
                {
                    "name": "X-CSRF-Token",
                    "value": "{{csrf}}"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [
                {
                    "re": "^(401|403|5[0-9][0-9])$",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "checkin_status",
                    "re": "(.+)",
                    "from": "status"
                }
            ]
        }
    },
    {
        "comment": "回查用户信息/获取签到数据与药丸余额",
        "request": {
            "method": "GET",
            "url": "https://invites.fun/api/users/{{uid}}",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/javascript, */*; q=0.01"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "identity"
                },
                {
                    "name": "Cookie",
                    "value": "flarum_remember={{remember}}{% if session %}; flarum_session={{session}}{% endif %}"
                },
                {
                    "name": "Referer",
                    "value": "https://invites.fun/"
                },
                {
                    "name": "User-Agent",
                    "value": "{{ua|default('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36')}}"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "total",
                    "re": "\"totalCheckinCount\":(\\d+)",
                    "from": "content"
                },
                {
                    "name": "days",
                    "re": "\"totalContinuousCheckIn\":(\\d+)",
                    "from": "content"
                },
                {
                    "name": "money",
                    "re": "\"money\":(\\d+)",
                    "from": "content"
                },
                {
                    "name": "lasttime",
                    "re": "\"lastCheckinTime\":\"([^\"]+)\"",
                    "from": "content"
                },
                {
                    "name": "__log__",
                    "re": "\"totalCheckinCount\":(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "生成日志（仅数字变量，避免特殊字符破坏参数）",
        "request": {
            "method": "GET",
            "url": "api://util/string/replace?t=%E7%AD%BE%E5%88%B0%E7%8A%B6%E6%80%81%EF%BC%9A{{checkin_status|urlencode}}%EF%BC%8C%E6%80%BB%E7%AD%BE%E5%88%B0%EF%BC%9A{{total|urlencode}}%EF%BC%8C%E8%BF%9E%E7%BB%AD%E7%AD%BE%E5%88%B0%EF%BC%9A{{days|urlencode}}%EF%BC%8C%E5%89%A9%E4%BD%99%E8%8D%AF%E4%B8%B8%EF%BC%9A{{money|urlencode}}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"OK\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"处理后字符串\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]