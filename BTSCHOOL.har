[
    {
        "comment": "签到",
        "request": {
            "method": "GET",
            "url": "https://pt.btschool.club/index.php?action=addbonus",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,zh-HK;q=0.7,en-US;q=0.6,en;q=0.5"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Alt-Used",
                    "value": "pt.btschool.club"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Referer",
                    "value": "https://pt.btschool.club/index.php"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "document"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "navigate"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-User",
                    "value": "?1"
                },
                {
                    "name": "Priority",
                    "value": "u=0, i"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "msg",
                    "re": "今天.+魔力值",
                    "from": "content"
                },
                {
                    "name": "traffic",
                    "re": "(分享率[\\s\\S]+?)<[^>]+>当前活动",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断是否签到成功",
        "request": {
            "method": "GET",
            "url": "{% if msg %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换，输出成功日志",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content={{msg}}\\r\\n{{ regex_replace(traffic, \"&nbsp;|&amp;\", \"\") | striptags}}。{{regex_replace(recheck_cnt | striptags, \"点击[\\s\\S]+目前\", \"\")}}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断条件不成立",
        "request": {
            "method": "GET",
            "url": "{% else %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换；输出未成功日志",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=签到动作完成，但未能获得签到成功信息，疑似今日已签到。\\r\\n{{ regex_replace(traffic, \"&nbsp;|&amp;\", \"\") | striptags}}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断块结束",
        "request": {
            "method": "GET",
            "url": "{% endif %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": []
        }
    }
]