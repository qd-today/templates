[
    {
        "comment": "网站登录",
        "request": {
            "method": "POST",
            "url": "https:///{{domian}}/api/session/password",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,zh-HK;q=0.7,en-US;q=0.6,en;q=0.5"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domian}}/login?return_to=%2F"
                },
                {
                    "name": "content-type",
                    "value": "application/json"
                },
                {
                    "name": "x-acg-request",
                    "value": "1"
                },
                {
                    "name": "Origin",
                    "value": "https://{{domian}}"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Alt-Used",
                    "value": "neosek.ai"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Priority",
                    "value": "u=0"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": [],
            "data": "{\"return_to\":\"/\",\"login\":\"{{account}}\",\"password\":\"{{password}}\"}",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "message[\": ]{2,6}success",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "data[\": ]{2,6}null",
                    "from": "content"
                }
            ],
            "extract_variables": []
        }
    },
    {
        "comment": "签到",
        "request": {
            "method": "POST",
            "url": "https:///{{domian}}/api/v1/me/checkin",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "Referer",
                    "value": "https://{{domian}}/"
                },
                {
                    "name": "x-acg-request",
                    "value": "1"
                },
                {
                    "name": "Origin",
                    "value": "https://{{domian}}"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Alt-Used",
                    "value": "{{domian}}"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Priority",
                    "value": "u=0"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "message[\": ]{2,6}success",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "message[\": ]{2,6}unauthorized",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "points",
                    "re": "granted[\": ]{2,6}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "total",
                    "re": "balance[\": ]{2,6}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "sign_flag",
                    "re": "already[\": ]{2,6}(.+?)[\", ]",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断是否已签到",
        "request": {
            "method": "GET",
            "url": "{% if points!=\"0\" %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换，签到成功",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{account}}，签到成功，获得{{points}}点。签到完，积分余额有{{total}}点。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断条件不成立",
        "request": {
            "method": "GET",
            "url": "{% else %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换，已签到",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{account}}，今日已签到，积分余额有{{total}}点。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断块结束",
        "request": {
            "method": "GET",
            "url": "{% endif %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": []
        }
    }
]