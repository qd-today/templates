[
    {
        "comment": "签到",
        "request": {
            "method": "POST",
            "url": "https://www.youjiaoku.com/wp-admin/admin-ajax.php",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/javascript, */*; q=0.01"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,zh-HK;q=0.7,en-US;q=0.6,en;q=0.5"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                },
                {
                    "name": "Origin",
                    "value": "https://www.youjiaoku.com"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Referer",
                    "value": "https://www.youjiaoku.com/"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Priority",
                    "value": "u=0"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "TE",
                    "value": "trailers"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "action=user_checkin",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "sign_flag",
                    "re": "error[\": ]{2,6}(\\w+)[,:} ]",
                    "from": "content"
                },
                {
                    "name": "msg",
                    "re": "msg[\": ]{2,6}(.*?)\" *?[,}] *?",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "获取信息",
        "request": {
            "method": "GET",
            "url": "https://www.youjiaoku.com/wp-admin/admin-ajax.php?action=checkin_details_modal",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.youjiaoku.com"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:158.0) Gecko/20100101 Firefox/158.0"
                },
                {
                    "name": "Accept",
                    "value": "*/*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,zh-HK;q=0.7,en-US;q=0.6,en;q=0.5"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br, zstd"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-GPC",
                    "value": "1"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Referer",
                    "value": "https://www.youjiaoku.com/"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Priority",
                    "value": "u=0"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "total_day",
                    "re": "累计签到<.*?>(\\d+)<.*?>天",
                    "from": "content"
                },
                {
                    "name": "today_msg",
                    "re": "class[=\" ]{2,10}px12[\"> ]{2,10}(.+)<.*?>",
                    "from": "content"
                },
                {
                    "name": "level",
                    "re": "我的等级.*?title[=\" ]{1,10}(.*?)[\" ]{1,10}",
                    "from": "content"
                },
                {
                    "name": "points",
                    "re": "我的积分.*?\\n{1,5}.*?[> ]{1,8}(\\d+)",
                    "from": "content"
                },
                {
                    "name": "jy",
                    "re": "[> ](\\d+)<.*?>经验值",
                    "from": "content"
                },
                {
                    "name": "sign_day",
                    "re": "已连续签到<.*?>(\\d*)<.*?>天",
                    "from": "content"
                },
                {
                    "name": "nickname",
                    "re": "avatar-id.*?[> ]{1,8}([^< ]+?)[< ]{1,8}",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断是否已签到",
        "request": {
            "method": "GET",
            "url": "{% if sign_flag and sign_flag==\"true\" %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换；已签到",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{nickname}}，等级{{level}}，{{msg}}\\r\\n目前已累计签到{{total_day}}天，共有积分{{points}}，经验值{{jy}}。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断条件不成立",
        "request": {
            "method": "GET",
            "url": "{% else %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "Unicode转换；未签过",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=用户：{{nickname}}，等级{{level}}，{{msg}}。\\r\\n签到完成后，已累计签到{{total_day}}天，共有积分{{points}}，经验值{{jy}}。"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "判断块结束",
        "request": {
            "method": "GET",
            "url": "{% endif %}",
            "headers": [],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    }
]