[
    {
        "comment": "1. 打开版块页，确认可访问",
        "request": {
            "method": "GET",
            "url": "https://www.deepflood.com/board",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36 Edg/125.0.0.0"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "text/html"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "2. 每日签到。random=true=试试手气；想要固定5鸡腿改为 random=false",
        "request": {
            "method": "POST",
            "url": "https://www.deepflood.com/api/attendance?random=true",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36 Edg/125.0.0.0"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "Origin",
                    "value": "https://www.nodeseek.com"
                },
                {
                    "name": "Referer",
                    "value": "https://www.nodeseek.com/board"
                },
                {
                    "name": "cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "鸡腿",
                    "from": "content"
                },
                {
                    "re": "已完成签到",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "(未登录|请先登录|登录失效|登录已过期|\"status\"\\s*:\\s*404)",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"message\"\\s*:\\s*\"([^\"]+)\"",
                    "from": "content"
                }
            ]
        }
    }
]