[
    {
        "comment": "1.个人资料",
        "request": {
            "method": "GET",
            "url": "http://www.anquyewww.avlang.com/home.php",
            "headers": [
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,en;q=0.7"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Referer",
                    "value": "http://www.anquyewww.avlang.com/home.php?mod=spacecp&ac=credit&op=log"
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36"
                },
                {
                    "name": "cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "2.我的积分",
        "request": {
            "method": "GET",
            "url": "http://www.anquyewww.avlang.com/home.php?mod=spacecp&ac=credit&op=base",
            "headers": [
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,zh-TW;q=0.8,en;q=0.7"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Pragma",
                    "value": "no-cache"
                },
                {
                    "name": "Referer",
                    "value": "http://www.anquyewww.avlang.com/home.php?mod=spacecp&ac=credit&op=log"
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36"
                },
                {
                    "name": "cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "jq",
                    "re": "狼币: </em>(\\d+)",
                    "from": "content"
                },
                {
                    "name": "jf",
                    "re": "积分: </em>(\\d+)",
                    "from": "content"
                },
                {
                    "name": "__log__",
                    "re": "狼币:{{jq}} | 积分:{{jf}}",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "Unicode转换",
        "request": {
            "method": "POST",
            "url": "api://util/unicode?content=%20%E7%8B%BC%E5%B8%81%3A%20{{jq|urlencode}}%20%7C%20%20%E7%A7%AF%E5%88%86%3A{{jf|urlencode}}",
            "headers": [],
            "cookies": [],
            "data": "content= 狼币: {{jq}} |  积分:{{jf}}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]