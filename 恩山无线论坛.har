[
    {
        "comment": "第1步：GET 恩山(erling_qd插件)签到页，提取 FORMHASH。用 plugin.php?id=erling_qd:sign_in，无需 u_atoken/u_asig。",
        "request": {
            "method": "GET",
            "url": "https://www.right.com.cn/forum/plugin.php?id=erling_qd:sign_in",
            "headers": [
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Referer",
                    "value": "https://www.right.com.cn/forum/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36 Edg/154.0.0.0"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "var FORMHASH = '[0-9a-f]+'",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "登录.{0,10}恩山无线论坛",
                    "from": "content"
                },
                {
                    "re": "您需要先登录",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "formhash",
                    "re": "var FORMHASH = '([0-9a-f]+)'",
                    "from": "content"
                },
                {
                    "name": "nickname",
                    "re": "class=\"erqd-nickname\">([^<]+)<",
                    "from": "content"
                },
                {
                    "name": "uid",
                    "re": "discuz_uid = '(\\d+)'",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "第2步：POST 执行签到，返回 JSON {\"success\":true,\"message\":\"签到成功\"}。",
        "request": {
            "method": "POST",
            "url": "https://www.right.com.cn/forum/plugin.php?id=erling_qd:action&action=sign",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/javascript, */*; q=0.01"
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                },
                {
                    "name": "Referer",
                    "value": "https://www.right.com.cn/forum/plugin.php?id=erling_qd:sign_in"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36 Edg/154.0.0.0"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "formhash={{formhash|urlencode}}",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"success\"\\s*:\\s*true",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "\"success\"\\s*:\\s*false",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "sign_credit",
                    "re": "\"credit\"\\s*:\\s*([0-9\\-]+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "第3步：再 GET 签到页读取 连续天数/总天数/今日积分。",
        "request": {
            "method": "GET",
            "url": "https://www.right.com.cn/forum/plugin.php?id=erling_qd:sign_in",
            "headers": [
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Referer",
                    "value": "https://www.right.com.cn/forum/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36 Edg/154.0.0.0"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "erqd-continuous-days",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "continuous",
                    "re": "连续签到：<span class=\"erqd-continuous-days\">([^<]+)<",
                    "from": "content"
                },
                {
                    "name": "total_days",
                    "re": "总签到天数：<span class=\"erqd-total-days\">([^<]+)<",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "第4步：GET 积分页读取恩山币余额。",
        "request": {
            "method": "GET",
            "url": "https://www.right.com.cn/forum/home.php?mod=spacecp&ac=credit&op=base",
            "headers": [
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Referer",
                    "value": "https://www.right.com.cn/forum/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36 Edg/154.0.0.0"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "恩山币",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "coin",
                    "re": "<em>\\s*恩山币\\s*[:：]\\s*</em>\\s*([\\d,\\.]+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "第5步：生成签到日志",
        "request": {
            "method": "POST",
            "url": "api://util/urldecode",
            "headers": [],
            "cookies": [],
            "data": "content=%E6%81%A9%E5%B1%B1%E7%AD%BE%E5%88%B0%EF%BC%9A%E8%B4%A6%E5%8F%B7%20{{nickname}}(uid={{uid}})%20%7C%20%E7%AD%BE%E5%88%B0%E6%88%90%E5%8A%9F%20%2B{{sign_credit}}%20%E7%A7%AF%E5%88%86%20%7C%20%E8%BF%9E%E7%BB%AD%20{{continuous}}%20%E5%A4%A9%20%7C%20%E7%B4%AF%E8%AE%A1%20{{total_days}}%20%E5%A4%A9%20%7C%20%E6%81%A9%E5%B1%B1%E5%B8%81%EF%BC%9A{{coin}}",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]