[
    {
        "comment": "读取登录、签到状态与当前总积分；允许同状态多副本，冲突或缺失即停止",
        "request": {
            "method": "GET",
            "url": "https://www.yhxs3344.net/user/",
            "httpVersion": "HTTP/1.1",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "{{cookie}}",
                    "checked": true
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0",
                    "checked": true
                },
                {
                    "name": "Referer",
                    "value": "https://www.yhxs3344.net/user/",
                    "checked": true
                }
            ],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "(?s)\\A(?=.*<body\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?logged-in(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>)(?=.*<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?(?:initiate-checkin|checkin-details-link)(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>)(?!(?=.*<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?initiate-checkin(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>)(?=.*<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?checkin-details-link(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>))(?=.*(?:<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?initiate-checkin(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>(?:(?!</a>).)*签到领取今日奖励(?:(?!</a>).)*</a>|<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?checkin-details-link(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>(?:(?!</a>).)*(?:今日)?已签到(?:(?!</a>).)*</a>))(?=.*积分\\s*<i\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?fa-angle-right(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*</i>\\s*</div>\\s*<div\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*<span\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?font-bold(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*(?P<current_points>0|[1-9][0-9]*)\\s*</span>)(?!.*积分\\s*<i\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?fa-angle-right(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*</i>\\s*</div>\\s*<div\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*<span\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?font-bold(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*(?!\\s)(?!(?P=current_points)\\s*</span>)[^<]*</span>).*\\Z(?#必须登录、仅一种签到状态且各积分副本一致)",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$).*$",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "yhxs_signed_before",
                    "re": "(?s)<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?(initiate-checkin|checkin-details-link)(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "仅未签到时提交一次",
        "request": {
            "method": "POST",
            "url": "{% if yhxs_signed_before == 'initiate-checkin' %}",
            "httpVersion": "HTTP/1.1",
            "headers": [],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "提交签到；只有明确 error:false 才继续，最终仍需回读确认",
        "request": {
            "method": "POST",
            "url": "https://www.yhxs3344.net/wp-admin/admin-ajax.php",
            "httpVersion": "HTTP/1.1",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "{{cookie}}",
                    "checked": true
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0",
                    "checked": true
                },
                {
                    "name": "Referer",
                    "value": "https://www.yhxs3344.net/user/",
                    "checked": true
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded",
                    "checked": true
                }
            ],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "action=user_checkin",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "(?s)\\A\\s*\\{(?=.*\"error\"\\s*:\\s*false(?=\\s*[,}]))(?!.*\"error\"\\s*:.*\"error\"\\s*:).*\\}\\s*\\Z(?#签到接口未明确返回error:false)",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$).*$",
                    "from": "status"
                }
            ],
            "extract_variables": []
        }
    },
    {
        "comment": "结束未签到条件",
        "request": {
            "method": "POST",
            "url": "{% endif %}",
            "httpVersion": "HTTP/1.1",
            "headers": [],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "从等级页同一最终响应读取今日状态、剩余总积分、当前等级与总经验；任一缺失或异常停止",
        "request": {
            "method": "GET",
            "url": "https://www.yhxs3344.net/user/level",
            "httpVersion": "HTTP/1.1",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "{{cookie}}",
                    "checked": true
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0",
                    "checked": true
                },
                {
                    "name": "Referer",
                    "value": "https://www.yhxs3344.net/user/",
                    "checked": true
                }
            ],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "(?s)\\A(?=.*<body\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?logged-in(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>)(?=.*<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?(?:initiate-checkin|checkin-details-link)(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>)(?!(?=.*<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?initiate-checkin(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>)(?=.*<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?checkin-details-link(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>))(?=.*<a\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?checkin-details-link(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>(?:(?!</a>).)*(?:今日)?已签到(?:(?!</a>).)*</a>)(?=.*积分\\s*<i\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?fa-angle-right(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*</i>\\s*</div>\\s*<div\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*<span\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?font-bold(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*(?P<current_points>0|[1-9][0-9]*)\\s*</span>)(?!.*积分\\s*<i\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?fa-angle-right(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*</i>\\s*</div>\\s*<div\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*<span\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?font-bold(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*(?!\\s)(?!(?P=current_points)\\s*</span>)[^<]*</span>)(?=.*<div\\b[^>]*(?<![\\w:-])id\\s*=\\s*[\\\"\\']user-tab-level[\\\"\\'][^>]*>(?:(?!<div\\b(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?ac(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?em14(?:\\s[^\\\"\\']*)?[\\\"\\'])[^>]*>).)*?<div\\b(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?ac(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?em14(?:\\s[^\\\"\\']*)?[\\\"\\'])[^>]*>\\s*<img\\b[^>]*(?<![\\w:-])title\\s*=\\s*[\\\"\\'](?P<current_level>LV(?:0|[1-9][0-9]*))[\\\"\\'][^>]*>\\s*<span\\b[^>]*>\\s*(?P=current_level)\\s*</span>\\s*</div>)(?=.*<div\\b[^>]*(?<![\\w:-])id\\s*=\\s*[\\\"\\']user-tab-level[\\\"\\'][^>]*>.*?<a\\b[^>]*(?<![\\w:-])href\\s*=\\s*[\\\"\\']#tab_integral_my[\\\"\\'][^>]*>\\s*我的经验值\\s*[:：]\\s*(0|[1-9][0-9]*)\\s*</a>).*\\Z(?#最终页面必须登录、今日已签到且各积分副本一致)",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$).*$",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "yhxs_final_points",
                    "re": "(?s)积分\\s*<i\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?fa-angle-right(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*</i>\\s*</div>\\s*<div\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*<span\\b[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?font-bold(?:\\s[^\\\"\\']*)?[\\\"\\'][^>]*>\\s*(0|[1-9][0-9]*)\\s*</span>",
                    "from": "content"
                },
                {
                    "name": "yhxs_final_level",
                    "re": "(?s)<div\\b[^>]*(?<![\\w:-])id\\s*=\\s*[\\\"\\']user-tab-level[\\\"\\'][^>]*>(?:(?!<div\\b(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?ac(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?em14(?:\\s[^\\\"\\']*)?[\\\"\\'])[^>]*>).)*?<div\\b(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?flex(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?ac(?:\\s[^\\\"\\']*)?[\\\"\\'])(?=[^>]*(?<![\\w:-])class\\s*=\\s*[\\\"\\'](?:[^\\\"\\']*\\s)?em14(?:\\s[^\\\"\\']*)?[\\\"\\'])[^>]*>\\s*<img\\b[^>]*(?<![\\w:-])title\\s*=\\s*[\\\"\\'](?P<current_level>LV(?:0|[1-9][0-9]*))[\\\"\\'][^>]*>\\s*<span\\b[^>]*>\\s*(?P=current_level)\\s*</span>\\s*</div>",
                    "from": "content"
                },
                {
                    "name": "yhxs_final_experience",
                    "re": "(?s)<div\\b[^>]*(?<![\\w:-])id\\s*=\\s*[\\\"\\']user-tab-level[\\\"\\'][^>]*>.*?<a\\b[^>]*(?<![\\w:-])href\\s*=\\s*[\\\"\\']#tab_integral_my[\\\"\\'][^>]*>\\s*我的经验值\\s*[:：]\\s*(0|[1-9][0-9]*)\\s*</a>",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "只记录最终响应的积分、等级、经验；真实0保留，缺失或异常此前已停止",
        "request": {
            "method": "POST",
            "url": "api://util/string/replace",
            "httpVersion": "HTTP/1.1",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded",
                    "checked": true
                }
            ],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "s={{ ('永恒心锁：今日已签到；剩余积分：' ~ yhxs_final_points ~ '；等级：' ~ yhxs_final_level ~ '；经验：' ~ yhxs_final_experience ~ '。')|urlencode }}&p=%5E%24&t=&r=text",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "\\A永恒心锁：今日已签到；剩余积分：(?:0|[1-9][0-9]*)；等级：LV(?:0|[1-9][0-9]*)；经验：(?:0|[1-9][0-9]*)。\\Z",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$).*$",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\\A永恒心锁：今日已签到；剩余积分：(?:0|[1-9][0-9]*)；等级：LV(?:0|[1-9][0-9]*)；经验：(?:0|[1-9][0-9]*)。\\Z",
                    "from": "content"
                }
            ]
        }
    }
]