[
    {
        "comment": "linux.sb 获取签到状态与 CSRF",
        "request": {
            "method": "GET",
            "url": "https://linux.sb/daily_checkin",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "{{ cookie|regex_replace('(?:^|; *)__daily_checkin_stats=[^;]*', '') }}"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "今天(?:待|已)签到",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$)",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "csrf",
                    "re": "name=\"_csrf\"\\s+value=\"([^\"]+)\"",
                    "from": "content"
                },
                {
                    "name": "checkin_state",
                    "re": "(今天(?:待|已)签到)",
                    "from": "content"
                },
                {
                    "name": "__log__",
                    "re": "(今天(?:待|已)签到)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "仅在今天待签到时提交",
        "request": {
            "method": "GET",
            "url": "{% if checkin_state == \"今天待签到\" %}",
            "headers": [],
            "cookies": []
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "linux.sb 执行每日签到",
        "request": {
            "method": "POST",
            "url": "https://linux.sb/daily_checkin",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "{{ cookie|regex_replace('(?:^|; *)__daily_checkin_stats=[^;]*', '') }}"
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                },
                {
                    "name": "X-Requested-With",
                    "value": "XMLHttpRequest"
                },
                {
                    "name": "Referer",
                    "value": "https://linux.sb/daily_checkin"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                }
            ],
            "cookies": [],
            "data": "_csrf={{ csrf|urlencode }}",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "(?s)(?=.*\"ok\"\\s*:\\s*(?:true|1))(?=.*\"redirect\"\\s*:\\s*\"[^\"]*/daily_checkin(?:\\?[^\"]*)?\")",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "\"ok\"\\s*:\\s*(?:false|0)|请求已过期",
                    "from": "content"
                },
                {
                    "re": "^(?!200$)",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "(?s)(\"ok\"\\s*:\\s*(?:true|1).*\"redirect\"\\s*:\\s*\"[^\"]*/daily_checkin(?:\\?[^\"]*)?\")",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "签到条件结束",
        "request": {
            "method": "GET",
            "url": "{% endif %}",
            "headers": [],
            "cookies": []
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    }
]