[
    {
        "comment": "linux.sb 每日签到",
        "request": {
            "method": "GET",
            "url": "https://linux.sb/daily_checkin",
            "headers": [
                {
                    "name": "Cookie",
                    "value": "{{ cookie }}"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": []
        }
    }
]