[
    {
        "comment": "",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "content={{flaresolverr|default(\"http://flaresolverr.d.test:8191/v1\")}}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "_",
                    "re": "",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "session",
        "request": {
            "method": "POST",
            "url": "{{flaresolverr}}",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/json"
                }
            ],
            "cookies": [],
            "data": "{\"cmd\": \"sessions.create\"}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "sessionid",
                    "re": "session\": \"(.+?)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "",
        "request": {
            "method": "POST",
            "url": "{{flaresolverr}}",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/json"
                }
            ],
            "cookies": [],
            "data": "{\n  \"cmd\": \"request.post\",\n  \"url\": \"https://i.pcbeta.com/member.php?mod=logging&action=login&loginsubmit=yes&inajax=1\",\n  \"postData\": \"username={{username}}&password={{password}}\",\n  \"session\": \"{{sessionid}}\",\n  \"cookies\": [],\n  \"maxTimeout\": 30000\n}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "",
        "request": {
            "method": "POST",
            "url": "{{flaresolverr}}",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/json"
                }
            ],
            "cookies": [],
            "data": "{\n  \"cmd\": \"request.get\",\n  \"url\": \"https://i.pcbeta.com/home.php?mod=task\",\n  \"session\": \"{{sessionid}}\",\n  \"returnOnlyCookies\": true,\n  \"disableMedia\": true,\n  \"maxTimeout\": 30000\n}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "cn",
                    "re": "/\"name\": \"(.+?)\"/g",
                    "from": "content"
                },
                {
                    "name": "cv",
                    "re": "/\"value\": \"(.+?)\"/g",
                    "from": "content"
                },
                {
                    "name": "ua",
                    "re": "userAgent\": \"(.+?)\"",
                    "from": "content"
                }
            ]
        }
    },
