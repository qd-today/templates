        "request": {
            "method": "POST",
            "url": "{{flaresolverr}}",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/json"
                }
            ],
            "cookies": [],
            "data": "{\"cmd\": \"sessions.destroy\", \"session\": \"{{sessionid}}\"}"
        },
        "rule": {
            "success_asserts": [
