[
    {
        "comment": "1. 打开登录页，提取 CSRF Token",
        "request": {
            "method": "GET",
            "url": "https://www.bandbbs.cn/login/",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "text/html"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "csrf",
                    "re": "csrf:\\s*'([^']+)'",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "2. 登录（用户名+密码），成功会 303 跳转",
        "request": {
            "method": "POST",
            "url": "https://www.bandbbs.cn/login/login",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                },
                {
                    "name": "Origin",
                    "value": "https://www.bandbbs.cn"
                },
                {
                    "name": "Referer",
                    "value": "https://www.bandbbs.cn/login/"
                }
            ],
            "cookies": [],
            "data": "_xfToken={{csrf|urlencode}}&login={{username}}&password={{password}}&remember=1&_xfRedirect=https%3A%2F%2Fwww.bandbbs.cn%2Fmembers%2F",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "303",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "密码错误，请重新输入",
                    "from": "content"
                },
                {
                    "re": "请求的用户.*?未找到",
                    "from": "content"
                }
            ],
            "extract_variables": []
        }
    },
    {
        "comment": "3. 访问会员页确认登录态",
        "request": {
            "method": "GET",
            "url": "https://www.bandbbs.cn/members/",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "text/html"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "4. 打开首页，提取本次会话的 CSRF Token",
        "request": {
            "method": "GET",
            "url": "https://www.bandbbs.cn/",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "text/html"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "csrf",
                    "re": "csrf:\\s*'([^']+)'",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "5. 每日签到（米粒钱包 mjc-credits/clock）。已签到视为成功不报错",
        "request": {
            "method": "POST",
            "url": "https://www.bandbbs.cn/mjc-credits/clock",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                },
                {
                    "name": "Origin",
                    "value": "https://www.bandbbs.cn"
                },
                {
                    "name": "Referer",
                    "value": "https://www.bandbbs.cn/"
                }
            ],
            "cookies": [],
            "data": "_xfToken={{csrf|urlencode}}",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "303",
                    "from": "status"
                },
                {
                    "re": "您已经签到了",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "6. 回首页提取签到统计（签到次数/本月奖励）",
        "request": {
            "method": "GET",
            "url": "https://www.bandbbs.cn/",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": "text/html"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "cs",
                    "re": "签到次数[\\s\\S]{0,30}?(\\d+)",
                    "from": "content"
                },
                {
                    "name": "ml",
                    "re": "本月奖励[\\s\\S]{0,30}?米粒(\\d+)粒",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "7. 组装任务日志（QD 内置 Unicode 转换工具）",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=签到{{cs}}次  本月奖励米粒{{ml}}粒",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]