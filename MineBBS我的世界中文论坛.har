[
    {
        "comment": "访问首页提取签到令牌(登录态校验)",
        "request": {
            "method": "GET",
            "url": "https://www.minebbs.com/",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.minebbs.com"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Cache-Control",
                    "value": "max-age=0"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Chromium\";v=\"21\", \" Not;A Brand\";v=\"99\""
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/95.0.4638.69 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "none"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "navigate"
                },
                {
                    "name": "Sec-Fetch-User",
                    "value": "?1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "document"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "data-logged-in=\"true\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "468",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "xftoken",
                    "re": "data-csrf=\"([^\"]+)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "每日签到(POST /credits/clock, 已签到时返回'您已经签到了')",
        "request": {
            "method": "POST",
            "url": "https://www.minebbs.com/credits/clock",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.minebbs.com"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Chromium\";v=\"21\", \" Not;A Brand\";v=\"99\""
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/95.0.4638.69 Safari/537.36"
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
                },
                {
                    "name": "Origin",
                    "value": "https://www.minebbs.com"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "navigate"
                },
                {
                    "name": "Sec-Fetch-User",
                    "value": "?1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "document"
                },
                {
                    "name": "Referer",
                    "value": "https://www.minebbs.com/"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "_xfToken={{xftoken|urlencode}}&currency_ids%5B%5D=1",
            "mimeType": "application/x-www-form-urlencoded"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "今日签到已完成|您已经签到了",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "今日尚未签到",
                    "from": "content"
                },
                {
                    "re": "468",
                    "from": "status"
                }
            ],
            "extract_variables": []
        }
    },
    {
        "comment": "账户页验证登录态并提取uid/用户名/金粒",
        "request": {
            "method": "GET",
            "url": "https://www.minebbs.com/account/",
            "headers": [
                {
                    "name": "Host",
                    "value": "www.minebbs.com"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Cache-Control",
                    "value": "max-age=0"
                },
                {
                    "name": "sec-ch-ua",
                    "value": "\"Chromium\";v=\"21\", \" Not;A Brand\";v=\"99\""
                },
                {
                    "name": "sec-ch-ua-mobile",
                    "value": "?0"
                },
                {
                    "name": "sec-ch-ua-platform",
                    "value": "\"Windows\""
                },
                {
                    "name": "Upgrade-Insecure-Requests",
                    "value": "1"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/95.0.4638.69 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "navigate"
                },
                {
                    "name": "Sec-Fetch-User",
                    "value": "?1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "document"
                },
                {
                    "name": "Referer",
                    "value": "https://www.minebbs.com/"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate, br"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9,en;q=0.8"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookie}}"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "/logout/",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "468",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "uid",
                    "re": "p-navgroup-link--user\"[^>]*>[\\s\\S]{0,400}?data-user-id=\"(\\d+)\"",
                    "from": "content"
                },
                {
                    "name": "username",
                    "re": "p-navgroup-link--user[\\s\\S]*?<span class=\"p-navgroup-linkText\">([^<]+)</span>",
                    "from": "content"
                },
                {
                    "name": "gold",
                    "re": "<dt>\\s*金粒\\s*</dt>\\s*<dd>\\s*([\\d,]+(?:\\.\\d+)?)\\s*金粒",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "生成日志",
        "request": {
            "method": "GET",
            "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E5%BD%93%E5%89%8D%E8%B4%A6%E6%88%B7%20{{username|urlencode}}%28uid%3D{{uid}}%29%20%7C%20%E3%80%90%E9%87%91%E7%B2%92%E3%80%91%EF%BC%9A{{gold|urlencode}}",
            "headers": [],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "re": ".+",
                    "from": "content",
                    "name": "__log__"
                }
            ]
        }
    }
]