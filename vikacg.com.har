                    "name": "sj_real",
                    "re": "\"sign_time\":[\\s]*(\\d{10})(\\d{3})",
                    "from": "content"
                },
                {
                    "name": "zjf",
                    "re": "\"count\":[\\s]*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "lx",
                    "re": "\"sign_days\":[\\s]*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "jr",
                    "re": "\"sign_count\":[\\s]*(\\d+)",
                    "from": "content"
                }
            ]
        }
