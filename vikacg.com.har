                    "name": "sj",
                    "re": "\"北京时间\"[^\"]*?\"([^\"]+)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "Unicode转换",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content=签到时间 {{sj}}，今日签到获得积分 {{jr}}，连续签到 {{lx}} 天，总积分 {{zjf}}"
