                    "from": "content"
                },
                {
                    "re": "{%set w=\"[ \\\\t\\\\r\\\\n]{0,64}\"%}{%set k=\"\\\"[^\\\"\\\\\\\\\\\\x00-\\\\x1f]*\\\"\"%}{%set a=\"(?:\\\"(?:[^\\\"\\\\\\\\\\\\x00-\\\\x1f]|\\\\\\\\(?:[\\\"\\\\\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\\\"|-?(?:0|[1-9][0-9]*)(?:\\\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|true|false|null)\"%}{%set b=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~a~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~a~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{%set c=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~b~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~b~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{{\"(?s)\\\\A(?=.*\\\"token\\\"\"~w~\":)(?!\\\\A\"~w~\"\\\\{\"~w~\"(?:(?!\\\"token\\\"\"~w~\":)\"~k~w~\":\"~w~c~w~\",\"~w~\")*\\\"token\\\"\"~w~\":\"~w~\"\\\"([A-Za-z0-9_-]{1,4096}\\\\.[A-Za-z0-9_-]{1,8192}\\\\.[A-Za-z0-9_-]{1,4096})\\\"(?:\"~w~\",\"~w~\"(?!\\\"token\\\"\"~w~\":)\"~k~w~\":\"~w~c~\")*\"~w~\"\\\\}\"~w~\"\\\\Z).*\\\\Z\"}}",
                    "from": "content"
