    {
        "comment": "账号模式：每次向本站登录一次，仅接受当次有效 token；验证码或登录错误立即停止",
        "request": {
            "method": "POST",
            "url": "https://xuejieba2026.com/wp-json/jwt-auth/v1/token",
            "httpVersion": "HTTP/1.1",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded",
                    "checked": true
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0",
                    "checked": true
                },
                {
                    "name": "Referer",
                    "value": "https://xuejieba2026.com/task",
                    "checked": true
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*",
                    "checked": true
                }
            ],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "username={{username|urlencode}}&password={{password|urlencode}}",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "{%set w=\"[ \\\\t\\\\r\\\\n]{0,64}\"%}{%set k=\"\\\"[^\\\"\\\\\\\\\\\\x00-\\\\x1f]*\\\"\"%}{%set a=\"(?:\\\"(?:[^\\\"\\\\\\\\\\\\x00-\\\\x1f]|\\\\\\\\(?:[\\\"\\\\\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\\\"|-?(?:0|[1-9][0-9]*)(?:\\\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|true|false|null)\"%}{%set b=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~a~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~a~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{%set c=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~b~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~b~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{{\"\\\\A\"~w~\"\\\\{\"~w~\"(?:(?!\\\"token\\\"\"~w~\":)\"~k~w~\":\"~w~c~w~\",\"~w~\")*\\\"token\\\"\"~w~\":\"~w~\"\\\"([A-Za-z0-9_-]{1,4096}\\\\.[A-Za-z0-9_-]{1,8192}\\\\.[A-Za-z0-9_-]{1,4096})\\\"(?:\"~w~\",\"~w~\"(?!\\\"token\\\"\"~w~\":)\"~k~w~\":\"~w~c~\")*\"~w~\"\\\\}\"~w~\"\\\\Z\"}}",
                    "from": "content"
                },
                {
                    "re": "\\A(?:(?!(?i:Set-Cookie):[ \\t]{0,64}b2_token=)[^\\r\\n]+\\n)*(?i:Set-Cookie):[ \\t]{0,64}b2_token=([A-Za-z0-9_-]{1,4096}\\.[A-Za-z0-9_-]{1,8192}\\.[A-Za-z0-9_-]{1,4096})(?![^\\r\\n]*b2_token=)(?:;[^\\r\\n]*)?[ \\t]{0,64}(?:\n(?!(?i:Set-Cookie):[ \\t]{0,64}b2_token=)[^\\r\\n]+)*\\Z",
                    "from": "header"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$).*$",
                    "from": "status"
                },
                {
                    "re": "{%set w=\"[ \\\\t\\\\r\\\\n]{0,64}\"%}{%set k=\"\\\"[^\\\"\\\\\\\\\\\\x00-\\\\x1f]*\\\"\"%}{%set a=\"(?:\\\"(?:[^\\\"\\\\\\\\\\\\x00-\\\\x1f]|\\\\\\\\(?:[\\\"\\\\\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\\\"|-?(?:0|[1-9][0-9]*)(?:\\\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|true|false|null)\"%}{%set b=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~a~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~a~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{%set c=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~b~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~b~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{%set d=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~c~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~c~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{{\"\\\\A(?!\"~w~d~w~\"\\\\Z)[\\\\s\\\\S]*\\\\Z\"}}",
                    "from": "content"
                },
                {
                    "re": "\"(?:code|error)\"[ \\t\\r\\n]{0,64}:",
                    "from": "content"
                },
                {
                    "re": "{%set w=\"[ \\\\t\\\\r\\\\n]{0,64}\"%}{%set k=\"\\\"[^\\\"\\\\\\\\\\\\x00-\\\\x1f]*\\\"\"%}{%set a=\"(?:\\\"(?:[^\\\"\\\\\\\\\\\\x00-\\\\x1f]|\\\\\\\\(?:[\\\"\\\\\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\\\"|-?(?:0|[1-9][0-9]*)(?:\\\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|true|false|null)\"%}{%set b=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~a~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~a~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{%set c=\"(?:\"~a~\"|\\\\{\"~w~\"(?:\"~w~\"|(?:\"~k~w~\":\"~w~b~w~\"(?:,\"~w~\"(?!\\\\})|(?=\\\\})))+)\\\\}|\\\\[\"~w~\"(?:\"~w~\"|(?:\"~b~w~\"(?:,\"~w~\"(?!\\\\])|(?=\\\\])))+)\\\\])\"%}{{\"\\\\A\"~w~\"\\\\{\"~w~\"(?:(?!\\\"code\\\"\"~w~\":)\"~k~w~\":\"~w~c~w~\",\"~w~\")*\\\"code\\\"\"~w~\":\"~w~c~\"(?:\"~w~\",\"~w~\"(?!\\\"code\\\"\"~w~\":)\"~k~w~\":\"~w~c~\")*\"~w~\"\\\\}\"~w~\"\\\\Z\"}}",
                    "from": "content"
