[
    {
        "comment": "严格二选一：填写账号密码且 Cookie 留空，或只填 Cookie；每次清空全部内部身份变量及旧业务日志",
        "request": {
            "method": "POST",
            "url": "api://util/string/replace",
            "httpVersion": "HTTP/1.1",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded",
                    "checked": true
                }
            ],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "s={{ ('mode=' ~ ('cookie' if (cookie|trim) and not username and not password else 'password' if (username|trim) and password and not (cookie|trim) else 'invalid') ~ ';reset=')|urlencode }}&p=%5E%24&t=&r=text",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "\\Amode=(cookie|password);reset=\\Z",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$).*$",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "xjb_auth_mode",
                    "re": "\\Amode=(cookie|password);reset=\\Z",
                    "from": "content"
                },
                {
                    "name": "xjb_auth_token",
                    "re": "reset=()\\Z",
                    "from": "content"
                },
                {
                    "name": "xjb_cookie_token",
                    "re": "reset=()\\Z",
                    "from": "content"
                },
                {
                    "name": "xjb_login_body_token",
                    "re": "reset=()\\Z",
                    "from": "content"
                },
                {
                    "name": "xjb_login_header_token",
                    "re": "reset=()\\Z",
                    "from": "content"
                },
                {
                    "name": "__log__",
                    "re": "reset=()\\Z",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "Cookie 模式：不会发起密码登录",
        "request": {
            "method": "POST",
            "url": "{% if xjb_auth_mode == 'cookie' %}",
            "httpVersion": "HTTP/1.1",
            "headers": [],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
        }
    },
    {
        "comment": "只从完整 Cookie 头提取唯一 b2_token；缺失、空值、重复、原始 token 或异常格式均停止",
        "request": {
            "method": "POST",
            "url": "api://util/string/replace",
            "httpVersion": "HTTP/1.1",
            "headers": [
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded",
                    "checked": true
                }
            ],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "s={{ (((cookie|trim)|regex_replace(\"\\\\A[ \\\\t]{0,64}(?:(?i:Cookie):[ \\\\t]{0,64})?(?:(?!b2_token=)[!#$%&'*+\\\\-.^_`|~0-9A-Za-z]{1,128}=[^\\\\x00-\\\\x20;\\\\x7f]{0,8192}[ \\\\t]{0,64};[ \\\\t]{0,64})*b2_token=([A-Za-z0-9_-]{1,4096}\\\\.[A-Za-z0-9_-]{1,8192}\\\\.[A-Za-z0-9_-]{1,4096})(?:[ \\\\t]{0,64};[ \\\\t]{0,64}(?!b2_token=)[!#$%&'*+\\\\-.^_`|~0-9A-Za-z]{1,128}=[^\\\\x00-\\\\x20;\\\\x7f]{0,8192})*[ \\\\t]{0,64};?[ \\\\t]{0,64}\\\\Z\", \"\\\\1\")) if ((cookie|trim)|regex_search(\"\\\\A[ \\\\t]{0,64}(?:(?i:Cookie):[ \\\\t]{0,64})?(?:(?!b2_token=)[!#$%&'*+\\\\-.^_`|~0-9A-Za-z]{1,128}=[^\\\\x00-\\\\x20;\\\\x7f]{0,8192}[ \\\\t]{0,64};[ \\\\t]{0,64})*b2_token=([A-Za-z0-9_-]{1,4096}\\\\.[A-Za-z0-9_-]{1,8192}\\\\.[A-Za-z0-9_-]{1,4096})(?:[ \\\\t]{0,64};[ \\\\t]{0,64}(?!b2_token=)[!#$%&'*+\\\\-.^_`|~0-9A-Za-z]{1,128}=[^\\\\x00-\\\\x20;\\\\x7f]{0,8192})*[ \\\\t]{0,64};?[ \\\\t]{0,64}\\\\Z\")) else 'INVALID_COOKIE')|urlencode }}&p=%5E%24&t=&r=text",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "\\A[A-Za-z0-9_-]{1,4096}\\.[A-Za-z0-9_-]{1,8192}\\.[A-Za-z0-9_-]{1,4096}\\Z",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "^(?!200$).*$",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "xjb_cookie_token",
                    "re": "\\A[A-Za-z0-9_-]{1,4096}\\.[A-Za-z0-9_-]{1,8192}\\.[A-Za-z0-9_-]{1,4096}\\Z",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "账号密码模式",
        "request": {
            "method": "POST",
            "url": "{% else %}",
            "httpVersion": "HTTP/1.1",
            "headers": [],
            "cookies": [],
            "queryString": [],
            "headersSize": -1,
            "bodySize": -1,
            "data": "",
            "mimeType": "text/plain"
        },
        "rule": {
            "success_asserts": [],
            "failed_asserts": [],
            "extract_variables": []
