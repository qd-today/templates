[
    {
        "comment": "第一步：获取签到状态（登录验证 + 今日是否已签到 + 连续签到天数）",
        "request": {
            "method": "GET",
            "url": "https://cn-cbu-gateway.ninebot.com/portal/api/user-sign/v2/status?t={{timestamp('int')}}",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Authorization",
                    "value": "{{authorization}}"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh-Hans;q=0.9"
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "Host",
                    "value": "cn-cbu-gateway.ninebot.com"
                },
                {
                    "name": "Origin",
                    "value": "https://h5-bj.ninebot.com"
                },
                {
                    "name": "from_platform_1",
                    "value": "1"
                },
                {
                    "name": "language",
                    "value": "zh"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 15_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Segway v6 C 609033420"
                },
                {
                    "name": "Referer",
                    "value": "https://h5-bj.ninebot.com/"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"code\":0",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "token",
                    "from": "content"
                },
                {
                    "re": "未登录|登录失效|权限|认证失败",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "consecutiveDays",
                    "re": "\"consecutiveDays\":(\\d+)",
                    "from": "content",
                    "default": "0"
                },
                {
                    "name": "signStatus",
                    "re": "\"currentSignStatus\":(\\d)",
                    "from": "content",
                    "default": "0"
                }
            ]
        }
    },
    {
        "comment": "第二步：判断今日是否已签到，如果未签到则执行签到操作",
        "request": {
            "method": "POST",
            "url": "https://cn-cbu-gateway.ninebot.com/portal/api/user-sign/v2/sign",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Authorization",
                    "value": "{{authorization}}"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh-Hans;q=0.9"
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "Host",
                    "value": "cn-cbu-gateway.ninebot.com"
                },
                {
                    "name": "Origin",
                    "value": "https://h5-bj.ninebot.com"
                },
                {
                    "name": "from_platform_1",
                    "value": "1"
                },
                {
                    "name": "language",
                    "value": "zh"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 15_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Segway v6 C 609033420"
                },
                {
                    "name": "Referer",
                    "value": "https://h5-bj.ninebot.com/"
                }
            ],
            "cookies": [],
            "data": "{\"deviceId\":\"{{deviceId}}\"}",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"code\":0",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "今日已经签到|重复签到|已完成",
                    "from": "content"
                }
            ]
        },
        "condition": "{{ signStatus | int() }} == 0"
    },
    {
        "comment": "第三步：签到成功后重新获取最新状态，更新连续签到天数",
        "request": {
            "method": "GET",
            "url": "https://cn-cbu-gateway.ninebot.com/portal/api/user-sign/v2/status?t={{timestamp('int')}}",
            "headers": [
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Authorization",
                    "value": "{{authorization}}"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh-Hans;q=0.9"
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "Host",
                    "value": "cn-cbu-gateway.ninebot.com"
                },
                {
                    "name": "Origin",
                    "value": "https://h5-bj.ninebot.com"
                },
                {
                    "name": "from_platform_1",
                    "value": "1"
                },
                {
                    "name": "language",
                    "value": "zh"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 15_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Segway v6 C 609033420"
                },
                {
                    "name": "Referer",
                    "value": "https://h5-bj.ninebot.com/"
                }
            ],
            "cookies": [],
            "data": "",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"code\":0",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "consecutiveDays",
                    "re": "\"consecutiveDays\":(\\d+)",
                    "from": "content",
                    "default": "0"
                }
            ]
        },
        "condition": "{{ signStatus | int() }} == 0"
    },
    {
        "comment": "第四步：输出签到结果日志",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "html_unescape=false&content={% if signStatus | int() == 1 %}今日已签到🎉，连续签到 {{consecutiveDays}} 天{% else %}签到成功🎉🎉，连续签到 {{consecutiveDays}} 天{% endif %}",
            "mimeType": ""
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]
