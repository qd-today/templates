[
    {
        "request": {
            "method": "POST",
            "url": "https://faroapi.com/api/user/login",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-store"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "Origin",
                    "value": "https://faroapi.com"
                },
                {
                    "name": "New-Api-User",
                    "value": "-1"
                },
                {
                    "name": "Referer",
                    "value": "https://faroapi.com/login"
                }
            ],
            "cookies": [],
            "data": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"success\"\\s*:\\s*true",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "Username or password is incorrect|用户名或密码错误",
                    "from": "content"
                },
                {
                    "re": "\"success\"\\s*:\\s*false",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "id",
                    "re": "\"id\"\\s*:\\s*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "display_name",
                    "re": "\"display_name\"\\s*:\\s*\"([^\"]+)\"",
                    "from": "content"
                },
                {
                    "name": "group_name",
                    "re": "\"group\"\\s*:\\s*\"([^\"]+)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "request": {
            "method": "POST",
            "url": "https://faroapi.com/api/user/checkin",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-store"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Content-Type",
                    "value": "application/json"
                },
                {
                    "name": "Origin",
                    "value": "https://faroapi.com"
                },
                {
                    "name": "New-Api-User",
                    "value": "{{id}}"
                },
                {
                    "name": "Referer",
                    "value": "https://faroapi.com/console/personal"
                }
            ],
            "cookies": [],
            "data": "{}",
            "mimeType": "application/json"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "Unauthorized|not logged in|New-Api-User header not provided",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "message",
                    "re": "\"message\"\\s*:\\s*\"([^\"]*)\"",
                    "from": "content"
                },
                {
                    "name": "checkin_date",
                    "re": "\"checkin_date\"\\s*:\\s*\"([^\"]*)\"",
                    "from": "content"
                },
                {
                    "name": "quota_awarded",
                    "re": "\"quota_awarded\"\\s*:\\s*(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "request": {
            "method": "GET",
            "url": "https://faroapi.com/api/user/checkin?month={{ date_time()[0:7] }}",
            "headers": [
