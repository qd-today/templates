    {
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-store"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                },
                {
                    "name": "New-Api-User",
                    "value": "-1"
                }
            ],
            "cookies": [],
            "data": "html_unescape=false&content=Faro API 签到结果：{{message}}\\r\\n用户：{{display_name}}（ID {{id}}）　邮箱：{{email|default('-', true)}}　分组：{{group_name}}\\r\\n签到日期：{{checkin_date|default('-', true)}}　本次获得：{{quota_awarded|default('0', true)}} 额度，折合约 ${{ format(float(divide(quota_awarded|default('0', true), 500000)), '.2f') }}\\r\\n本月签到：{{checkin_count|default('0', true)}} 天，本月累计：{{total_quota|default('0', true)}} 额度\\r\\n当前余额：{{quota}} 额度，折合约 ${{ format(float(divide(quota, 500000)), '.2f') }}；已用 {{used_quota}} 额度，累计请求 {{request_count}} 次\\r\\n邀请码：{{aff_code|default('-', true)}}　邀请奖励：{{aff_quota|default('0', true)}} 额度"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\"\\s*:\\s*\"(.*?)\"\\s*[,}]",
                    "from": "content"
                }
            ]
        }
    }
]