                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"
                },
                {
                    "name": "Accept",
                    "value": "application/json, text/plain, */*"
                },
                {
                    "name": "Accept-Language",
                    "value": "zh-CN,zh;q=0.9"
                },
                {
                    "name": "Accept-Encoding",
                    "value": "gzip, deflate"
                },
                {
                    "name": "Cache-Control",
                    "value": "no-store"
                },
                {
                    "name": "DNT",
                    "value": "1"
                },
                {
                    "name": "Sec-Fetch-Dest",
                    "value": "empty"
                },
                {
                    "name": "Sec-Fetch-Mode",
                    "value": "cors"
                },
                {
                    "name": "Sec-Fetch-Site",
                    "value": "same-origin"
                },
                {
                    "name": "Connection",
                    "value": "keep-alive"
                },
                {
                    "name": "New-Api-User",
                    "value": "{{id}}"
                },
                {
                    "name": "Referer",
                    "value": "https://faroapi.com/console/personal"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "Unauthorized|not logged in|New-Api-User header not provided",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "checkin_count",
                    "re": "\"checkin_count\"\\s*:\\s*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "total_quota",
                    "re": "\"total_quota\"\\s*:\\s*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "total_checkins",
                    "re": "\"total_checkins\"\\s*:\\s*(\\d+)",
                    "from": "content"
                },
                {
                    "name": "checked_in_today",
                    "re": "\"checked_in_today\"\\s*:\\s*(true|false)",
                    "from": "content"
                }
            ]
        }
    },
